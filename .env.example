# Copy this file to .env for local development. Never commit real secrets.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-bytes
POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=task_manager
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://task_manager:task_manager@localhost:55432/task_manager

# Local HTTP development only. Production must use true behind HTTPS.
JWT_COOKIE_SECURE=false
JWT_ACCESS_TOKEN_MINUTES=15
